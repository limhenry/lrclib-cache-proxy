# Host port Docker binds on. Change this to expose on a different port (e.g. 9876).
# The container always listens internally on PORT=3000.
HOST_PORT=3000

# Port the HTTP server listens on inside the container.
PORT=3000

# Path to the SQLite database file.
# When running via Docker the volume is mounted at /data.
DB_PATH=/data/lyrics.db

# Base URL of the upstream lrclib instance.
LRCLIB_BASE_URL=https://lrclib.net

# Days to serve a cached 404 before re-checking lrclib.
NOT_FOUND_TTL_DAYS=7
